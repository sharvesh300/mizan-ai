DATABASE_URL=./db/sqlite.db

# OpenRouter — powers the LangGraph intake agent (lib/ai/*).
# Leave blank to run the deterministic scripted intake with no model calls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
# Free models share an upstream pool and answer 429 without warning. OpenRouter
# serves the first model in this list that has capacity, so a throttled primary
# costs a slower turn instead of a failed one. Comma-separated, tried in order.
# OpenRouter accepts at most 3 models per request, primary included — so this
# list is trimmed to 2 entries in practice.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="Mizan AI"
