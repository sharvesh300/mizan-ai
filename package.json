{
  "name": "mizan-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run db/seed/run.ts",
    "dump:outputs": "bun --conditions=react-server run db/seed/dump-outputs.ts",
    "check:servicing": "bun run db/seed/check-servicing.ts && bun run db/seed/check-servicing-tools.ts && bun run db/seed/check-cards.tsx && bun run db/seed/check-ledger.ts && bun run db/seed/check-registers.ts && bun run db/seed/check-servicing-session.ts && bun run db/seed/check-appeal.ts && bun run db/seed/check-appeal-signoff.ts && bun run db/seed/check-handoff.ts && bun --conditions=react-server run db/seed/check-reassess.ts && bun --conditions=react-server run db/seed/check-settlement.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/openai": "^1.5.13",
    "@shadcn/react": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
