  "cards": [
    { "dot": "cyan", "title": "Two Reviews, Never One", "items": ["Review 1 gates a flagged record before pricing ever starts", "Review 1.5 is a parallel quality check — it never withholds the card", "Review 2 gates policy issuance on the applicant's OWN choice"] },
    { "dot": "emerald", "title": "Grounded, Not Guessed", "items": ["The agent supplies no numbers of its own — every figure traces to a tool observation", "A closed vocabulary per tool: plan ids, need ids, benefit classes, cost scenarios", "The same read-only registry answers in-chat questions once the panel is shown", "A citation failure swaps in the already-vetted member reasoning"] },
    { "dot": "rose", "title": "Runs With No Model", "items": ["No API key, a rate limit, or an exhausted call budget all fall back to deterministic ranking", "The applicant still gets a card — confidence low, flagged for review", "Round 2 re-runs the loop with the objection on record, capped at 3 tries"] }
